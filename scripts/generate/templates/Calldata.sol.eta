pragma solidity ^0.8.20;

/**
 * @dev Helper library for manipulating objects in calldata.
 */
library Calldata {
<%- for (const { type, name } of it.CALLDATA_TYPES) { %>
    /// @dev Returns an empty `<%= type %> calldata`.
    // slither-disable-next-line write-after-write
    function empty<%= name %>() internal pure returns (<%= type %> calldata result) {
        assembly ("memory-safe") {
            result.offset := 0
            result.length := 0
        }
    }
<% } -%>
<%- for (const { type, name } of it.CALLDATA_ARRAY_TYPES) { %>
    /// @dev Returns an empty `<%= type %>[] calldata`.
    // slither-disable-next-line write-after-write
    function empty<%= name %>Array() internal pure returns (<%= type %>[] calldata result) {
        assembly ("memory-safe") {
            result.offset := 0
            result.length := 0
        }
    }
<% } -%>
}
