pragma solidity ^0.8.20;

/**
 * @dev Library for managing bytes-based mappings in a compact and efficient way, provided the keys are sequential.
 * Largely inspired by Uniswap's https://github.com/Uniswap/merkle-distributor/blob/master/contracts/MerkleDistributor.sol[merkle-distributor].
 *
 * The library provides several map types that pack multiple values into single 256-bit storage slots:
 *
 * * `BitMap`: 256 booleans per slot (1 bit each)
<% for (const { bits, name } of it.BITMAP_TYPES) { -%>
 * * `<%= name %>`: <%= 256 / bits %> <%= bits %>-bit values per slot
<% } -%>
 *
 * This approach provides significant gas savings compared to using individual storage slots for each value:
 *
 * * Setting a zero value to non-zero only once every N times (where N is the packing density)
 * * Accessing the same warm slot for every N _sequential_ indices
 */
library BitMaps {
    struct BitMap {
        mapping(uint256 bucket => uint256) _data;
    }

    /**
     * @dev Returns whether the bit at `index` is set.
     */
    function get(BitMap storage bitmap, uint256 index) internal view returns (bool) {
        uint256 bucket = index >> 8;
        uint256 mask = 1 << (index & 0xff);
        return bitmap._data[bucket] & mask != 0;
    }

    /**
     * @dev Sets the bit at `index` to the boolean `value`.
     */
    function setTo(BitMap storage bitmap, uint256 index, bool value) internal {
        if (value) {
            set(bitmap, index);
        } else {
            unset(bitmap, index);
        }
    }

    /**
     * @dev Sets the bit at `index`.
     */
    function set(BitMap storage bitmap, uint256 index) internal {
        uint256 bucket = index >> 8;
        uint256 mask = 1 << (index & 0xff);
        bitmap._data[bucket] |= mask;
    }

    /**
     * @dev Unsets the bit at `index`.
     */
    function unset(BitMap storage bitmap, uint256 index) internal {
        uint256 bucket = index >> 8;
        uint256 mask = 1 << (index & 0xff);
        bitmap._data[bucket] &= ~mask;
    }
<% for (const { bits, name } of it.BITMAP_TYPES) {
     const per = 256 / bits;
     const width = Math.log2(bits);
     const type = `uint${Math.max(bits, 8)}`;
     const max = it.toBeHex((1n << BigInt(bits)) - 1n);
     const mask = it.toBeHex(per - 1);
-%>

    struct <%= name %> {
        mapping(uint256 bucket => uint256) _data;
    }

    /**
     * @dev Returns the <%= bits %>-bit value at `index` in `map`.
     */
    function get(<%= name %> storage map, uint256 index) internal view returns (<%= type %>) {
        uint256 bucket = index >> <%= 8 - width %>; // <%= per %> values per bucket (256/<%= bits %>)
        uint256 shift = (index & <%= mask %>) << <%= width %>; // i.e. (index % <%= per %>) * <%= bits %> = position * <%= bits %>
        return <%= type %>(<% if (bits < 8) { %>(map._data[bucket] >> shift) & <%= max %><% } else { %>map._data[bucket] >> shift<% } %>);
    }

    /**
     * @dev Sets the <%= bits %>-bit value at `index` in `map`.
     *
     * NOTE: Assumes `value` fits in <%= bits %> bits. Assembly-manipulated values may corrupt adjacent data.
     */
    function set(<%= name %> storage map, uint256 index, <%= type %> value) internal {
        uint256 bucket = index >> <%= 8 - width %>; // <%= per %> values per bucket (256/<%= bits %>)
        uint256 shift = (index & <%= mask %>) << <%= width %>; // i.e. (index % <%= per %>) * <%= bits %> = position * <%= bits %>
        uint256 mask = <%= max %> << shift;
        map._data[bucket] = (map._data[bucket] & ~mask) | (uint256(value) << shift); // set the <%= bits %> bits
    }
<% } -%>
}
