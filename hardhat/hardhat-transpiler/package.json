{
  "name": "hardhat-transpiler",
  "version": "0.1.0",
  "description": "Transpile contracts into their upgrade-safe variant",
  "license": "MIT",
  "author": "OpenZeppelin Community <maintainers@openzeppelin.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenZeppelin/openzeppelin-contracts.git",
    "directory": "hardhat/hardhat-transpiler"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
