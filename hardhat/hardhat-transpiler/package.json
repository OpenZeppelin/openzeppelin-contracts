  "scripts": {
    "clean": "rimraf dist",
    "prepare": "npm run clean && tsc"
  },
  "dependencies": {
    "@openzeppelin/upgrade-safe-transpiler": "^0.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
